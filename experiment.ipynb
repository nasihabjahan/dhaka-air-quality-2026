import pandas as pd
df= pd.read_csv('air_quality_2026.csv')

cities = pd.read_csv("cities.csv")
cities.head()

df = df.merge(
    cities[["ID", "Name"]],
    left_on="Location ID",
    right_on="ID",
    how="left"
)

df = df.drop(columns=["Location ID", "ID_y"], errors="ignore")
df = df.rename(columns={"ID_x": "ID", "Name": "City"})

df.head()

dhaka_cities = [
    "Tungi",
    "Dohār",
    "Nārāyanganj",
    "Dhaka",
    "Azimpur",
    "Paltan"
]

filtered_df = df[df["City"].isin(dhaka_cities)]

filtered_df.head()

print(filtered_df["City"].value_counts())
#So not all cities have the same amount of AQI data

filtered_df.isnull().sum()
#No null values found


filtered_df["Timestamp"] = pd.to_datetime(filtered_df["Timestamp"], format="mixed", utc=True)

# Extract the date
filtered_df["Date"] = filtered_df["Timestamp"].dt.date

# Combine hourly records into daily records for each city
daily_df = (
    filtered_df.groupby(["Date", "City"], as_index=False)
      .agg({
          "AQI US": "max",
          "AQI EU": "max",
          "PM2.5": "mean",
          "PM10": "mean",
          "O3": "mean",
          "NO2": "mean",
          "SO2": "mean",
          "CO": "mean"
      })
)

daily_df.head(12)
