import pandas as pd
df= pd.read_csv('air_quality_2026.csv')

cities = pd.read_csv("cities.csv")
cities.head()

df = df.merge(
    cities[["ID", "Name"]],
    left_on="Location ID",
    right_on="ID",
    how="left"
)

df = df.drop(columns=["Location ID", "ID_y"], errors="ignore")
df = df.rename(columns={"ID_x": "ID", "Name": "City"})

df.head()

dhaka_cities = [
    "Tungi",
    "Dohār",
    "Nārāyanganj",
    "Dhaka",
    "Azimpur",
    "Paltan"
]

filtered_df = df[df["City"].isin(dhaka_cities)]

filtered_df.head()

print(filtered_df["City"].value_counts())
#So not all cities have the same amount of AQI data

filtered_df.isnull().sum()
#No null values found


filtered_df["Timestamp"] = pd.to_datetime(filtered_df["Timestamp"], format="mixed", utc=True)

# Extract the date
filtered_df["Date"] = filtered_df["Timestamp"].dt.date

# Combine hourly records into daily records for each city
daily_df = (
    filtered_df.groupby(["Date", "City"], as_index=False)
      .agg({
          "AQI US": "max",
          "AQI EU": "max",
          "PM2.5": "mean",
          "PM10": "mean",
          "O3": "mean",
          "NO2": "mean",
          "SO2": "mean",
          "CO": "mean"
      })
)

daily_df.head(12)


daily_df["Date"] = pd.to_datetime(daily_df["Date"])

daily_df = daily_df.sort_values(["City", "Date"]).copy()

next_date = daily_df.groupby("City")["Date"].shift(-1)
next_aqi = daily_df.groupby("City")["AQI US"].shift(-1)

is_tomorrow = (
    next_date == daily_df["Date"] + pd.Timedelta(days=1)
)

daily_df["Tomorrow AQI"] = next_aqi.where(is_tomorrow)

daily_df = daily_df.drop("AQI EU", axis=1, errors="ignore")

print("Valid targets:", daily_df["Tomorrow AQI"].notna().sum())
print("Missing targets:", daily_df["Tomorrow AQI"].isna().sum())

# Check the six cities on July 15 where no AQI values exist
display(
    daily_df[daily_df["Date"] == pd.Timestamp("2026-07-15")][
        ["City", "Date", "AQI US", "Tomorrow AQI"]
    ]
)


features = ['PM2.5', 'PM10', 'O3', 'NO2', 'SO2', 'CO']


check = daily_df.sort_values(["City", "Date"]).copy()

check["Next date"] = check.groupby("City")["Date"].shift(-1)
check["Next AQI"] = check.groupby("City")["AQI US"].shift(-1)

check["Recalculated target"] = check["Next AQI"].where(
    check["Next date"] == check["Date"] + pd.Timedelta(days=1)
)

daily_df["Tomorrow AQI"] = check["Recalculated target"]


daily_df = daily_df.dropna(subset=["Tomorrow AQI"]).copy()


X = daily_df[features]
y = daily_df["Tomorrow AQI"]


split_date = pd.Timestamp("2026-07-01")

train = daily_df["Date"] < split_date
test = daily_df["Date"] >= split_date

X_train = X[train]
y_train = y[train]

X_test = X[test]
y_test = y[test]

from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LinearRegression

scaler = StandardScaler()

X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)


#LINEAR REGRESSION
from sklearn.linear_model import LinearRegression

lr_model = LinearRegression()

lr_model.fit(X_train_scaled, y_train)

lr_predictions = lr_model.predict(X_test_scaled)

print("Actual AQI values:")
print(y_test.head(10).to_list())

print("\nPredicted AQI values:")
print(lr_predictions[:10])





#RANDOM FOREST
from sklearn.ensemble import RandomForestRegressor

rf_model = RandomForestRegressor(
    n_estimators=100,
    random_state=42
)

rf_model.fit(X_train, y_train)

rf_predictions = rf_model.predict(X_test)

print("Actual AQI values:")
print(y_test.head(10).to_list())

print("\nPredicted AQI values:")
print(rf_predictions[:10])



#DECISION TREE
from sklearn.tree import DecisionTreeRegressor

dt_model = DecisionTreeRegressor(random_state=42)

dt_model.fit(X_train, y_train)

dt_predictions = dt_model.predict(X_test)

print("Actual AQI values:")
print(y_test.head(10).to_list())

print("\nPredicted AQI values:")
print(dt_predictions[:10])




#SVM
from sklearn.svm import SVR

svm_model = SVR()

svm_model.fit(X_train_scaled, y_train)

svm_predictions = svm_model.predict(X_test_scaled)

print("Actual AQI values:")
print(y_test.head(10).to_list())

print("\nPredicted AQI values:")
print(svm_predictions[:10])




#KNN
from sklearn.neighbors import KNeighborsRegressor

knn_model = KNeighborsRegressor(n_neighbors=5)

knn_model.fit(X_train_scaled, y_train)

knn_predictions = knn_model.predict(X_test_scaled)

print("Actual AQI values:")
print(y_test.head(10).to_list())

print("\nPredicted AQI values:")
print(knn_predictions[:10])
